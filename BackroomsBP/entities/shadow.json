{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "backrooms:shadow",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "backrooms:vanish": {
        "minecraft:instant_despawn": {}
      },
      "backrooms:clerk": { "minecraft:variant": { "value": 0 } },
      "backrooms:office": { "minecraft:variant": { "value": 1 } },
      "backrooms:janitor": { "minecraft:variant": { "value": 2 } },
      "backrooms:leaving": {
        "minecraft:movement": { "value": 0.12 },
        "minecraft:movement.basic": {},
        "minecraft:navigation.walk": { "can_walk": true, "avoid_water": true, "avoid_damage_blocks": true },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 1,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 16,
              "walk_speed_multiplier": 1.0,
              "sprint_speed_multiplier": 1.0
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["backrooms", "backrooms_shadow"] },
      "minecraft:collision_box": { "width": 0.6, "height": 2.0 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:knockback_resistance": { "value": 1.0, "max": 1.0 },
      "minecraft:fire_immune": true,
      "minecraft:breathable": { "breathes_water": true, "breathes_air": true },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": "no",
            "on_damage": { "event": "backrooms:vanish", "target": "self" }
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          { "weight": 2, "add": { "component_groups": ["backrooms:clerk"] } },
          { "weight": 2, "add": { "component_groups": ["backrooms:office"] } },
          { "weight": 1, "add": { "component_groups": ["backrooms:janitor"] } }
        ]
      },
      "backrooms:vanish": {
        "add": { "component_groups": ["backrooms:vanish"] }
      },
      "backrooms:walk_away": {
        "add": { "component_groups": ["backrooms:leaving"] }
      }
    }
  }
}
